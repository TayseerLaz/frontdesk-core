# ---------------------------------------------------------------------------
# Platform core — environment
#
# ONLY FOUR VARIABLES ARE REQUIRED TO BOOT:
#   DATABASE_URL  REDIS_URL  JWT_ACCESS_SECRET  JWT_REFRESH_SECRET
#
# Everything else degrades gracefully. Storage returns 503 without Wasabi keys,
# push is a no-op without Firebase, email falls back to Mailpit, WhatsApp
# Embedded Signup reports itself unconfigured, and every AI provider is
# optional. Each integration lights up the moment you add its key.
#
# Cold start:
#   cp .env.example .env      # fill the four above + BRAND_* + INITIAL_ADMIN_*
#   docker compose up -d
#   pnpm install && pnpm bootstrap && pnpm dev
# ---------------------------------------------------------------------------

# ---------- BRAND -----------------------------------------------------------
# The only place a product name exists. Nothing in the code hard-codes one.
# NEXT_PUBLIC_* twins are required because Next inlines them into the browser
# bundle at build time — set both halves to the same value.
BRAND_NAME="Platform"
BRAND_LEGAL_NAME="Platform"
BRAND_TAGLINE=""
BRAND_DOMAIN="localhost"
BRAND_SUPPORT_EMAIL="support@localhost"
# Comma-separated internal recipients for handoff / operational alerts.
BRAND_TEAM_EMAILS=""
# Primary accent. Also set the ramp in apps/web/src/styles/globals.css.
BRAND_ACCENT_HEX="#1F5E8C"

NEXT_PUBLIC_BRAND_NAME="Platform"
NEXT_PUBLIC_BRAND_DOMAIN="localhost"
NEXT_PUBLIC_BRAND_TAGLINE=""
NEXT_PUBLIC_BRAND_ACCENT_HEX="#1F5E8C"

# ---------- FIRST ADMIN (used by `pnpm bootstrap`) --------------------------
# Creates/updates the super-admin. Idempotent — safe on every deploy.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="change-me-at-least-12-chars"

NODE_ENV=development
LOG_LEVEL=debug

# --- API server ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Portal runs under Next.js basePath '/app' — keep the /app suffix so the API
# mints working email links (reset / verify / invite). In prod: https://example.com/app
WEB_PUBLIC_URL=http://localhost:3000/app

# Google Calendar (per-tenant one-way booking sync). Optional — the integration
# is dormant until both are set. Create an OAuth client in Google Cloud, enable
# the Google Calendar API, and add the redirect URI:
#   ${API_PUBLIC_URL}/api/v1/google-calendar/callback
# (prod: https://api.example.com/api/v1/google-calendar/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CORS_ORIGINS=http://localhost:3000

# --- Database -----------------------------------------------------------
# App connects via PgBouncer (port 6432) in prod. Direct 5432 for migrations.
DATABASE_URL="postgresql://platform:platform@localhost:5432/platform?schema=public&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://platform:platform@localhost:5432/platform?schema=public"

# --- Redis --------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth / JWT ---------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="change-me-access-secret-must-be-at-least-32-characters-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-must-be-at-least-32-characters-long"
JWT_ACCESS_TTL_SECONDS=900
# 2592000 = 30 days, SLIDING (extended on every refresh) — the "stay signed
# in on my phone" window. Refresh-token rotation + reuse-detection cap the
# leak damage window. Lower it per-env for stricter tenants.
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Email (SMTP) -------------------------------------------------------
# Dev: leave EMAIL_SMTP_HOST empty to use Mailhog (smtp://localhost:1025)
# Prod: set the AWS SES SMTP block below.
EMAIL_FROM="the platform <noreply@platform.local>"
EMAIL_DEV_SMTP_HOST=localhost
EMAIL_DEV_SMTP_PORT=1025
#EMAIL_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#EMAIL_SMTP_PORT=587
#EMAIL_SMTP_USER=
#EMAIL_SMTP_PASS=
#EMAIL_SMTP_SECURE=false

# --- Object storage (Wasabi, S3-compatible) -----------------------------
# Leave keys empty to run dev without uploads (presign endpoint will 503).
WASABI_ENDPOINT="https://s3.eu-central-1.wasabisys.com"
WASABI_REGION="eu-central-1"
WASABI_BUCKET="platform-dev"
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_PUBLIC_URL_BASE="https://platform-dev.s3.eu-central-1.wasabisys.com"
WASABI_SIGNED_URL_TTL_SECONDS=900

# --- WhatsApp (Meta Cloud API) ------------------------------------------
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN="change-me-webhook-verify-token"
META_WA_APP_SECRET=

# --- Observability ------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Voice gateway (Aseer-time voicebot, shared multi-tenant mode) -------
# Platform secret (NOT org-scoped) shared only with the trusted voicebot infra.
# When set, the voicebot resolves an inbound dialed number to a tenant phone
# line via GET /voice/resolve and posts call lifecycle with this secret +
# X-Phone-Integration-Id. Leave empty to disable gateway mode (per-line
# X-Platform-Api-Key auth keeps working regardless).
VOICE_GATEWAY_SECRET=

# --- Rate limiting ------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_SECOND=100
RATE_LIMIT_READ_API_PER_SECOND=200

# --- Custom CNAMEs / on-demand TLS --------------------------------------
# Hostname customers should point their CNAME at. Caddy issues certs on
# demand once /api/v1/caddy/ask returns 200 for a verified domain.
CUSTOM_CNAME_TARGET="example.com"

# --- WAF / edge proxy trust (Sprint 4) ----------------------------------
# Controls which upstream proxies the API trusts when reading
# X-Forwarded-For. See apps/api/src/lib/trust-proxy.ts.
#   true       trust any proxy (default — safe ONLY when the API is
#              behind Caddy on a private network).
#   false      trust none (req.ip = socket peer).
#   cloudflare preset: Cloudflare IPv4 + IPv6 + LAN/loopback.
#   CIDR list  e.g. 10.0.0.0/8,2606:4700::/32
TRUST_PROXY=true
# When 'true', honour CF-Connecting-IP for req.ip. Set ONLY when behind
# Cloudflare and TRUST_PROXY is configured to include their ranges.
TRUST_CF_CONNECTING_IP=false

# --- Groq (chat completions — REQUIRED for bot replies) ---------------
# Llama 3.3 70B on Groq's LPU runs at ~500 tok/sec vs OpenAI's ~50-100
# tok/sec, so bot replies land in 3-8s instead of 22-26s. The API and
# the worker both require this key for chat completions — if it's not
# set, bot reply attempts throw a "GROQ_API_KEY is not configured" error
# instead of silently falling back to OpenAI (which used to mask the
# misconfig). Sign up at https://console.groq.com — free tier is fine
# for low-volume; paid tier removes the 30 req/min limit.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- MyFatoorah (Kuwait payment gateway) -------------------------------
# Used by the bot to mint per-order invoice URLs at checkout. Sandbox
# URL = https://apitest.myfatoorah.com. Production = https://api.myfatoorah.com.
# When MYFATOORAH_API_KEY is unset, the bot's payment-link request
# strips the [PAYMENT_LINK] marker with a soft "we'll send you a link
# shortly" message instead of leaking a fake URL.
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com

# --- OpenAI (transcription only) ---------------------------------------
# OpenAI is kept exclusively for voice-note transcription
# (gpt-4o-transcribe is materially better on Arabic dialects than Groq's
# Whisper Large v3 — the platform's customer base is Gulf/Levant Arabic
# so this matters). Chat completions DO NOT use this key.
# Leave empty to disable voice transcription (text-only bot still works).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Anthropic (Claude) — powers the `max` and `ultra` AI plans (max = Claude
# Sonnet, ultra = Sonnet + Haiku-assisted per-contact memory). When unset, both
# plans degrade to `basic` (Groq). SET THE REAL VALUE ONLY IN .env.production ON
# THE SERVER — never commit it. Placeholder here for documentation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_ULTRA_MODEL=claude-sonnet-4-6

# --- Retrieval reranker (optional; hybrid retrieval works without it) -----
# RERANK_MODE: off (default) | shadow (call + log, don't apply) | enforce
RERANK_MODE=off
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
RERANK_CANDIDATE_N=60
RERANK_TIMEOUT_MS=4000

# --- the platform lead outreach (auto-WhatsApp example.com website leads) ------------
# When a number is submitted on example.com, the support-tenant bot proactively
# texts it — a business-initiated first message, so it needs an APPROVED Meta
# template on the support-tenant WABA. Set the template name/lang here; the
# feature is INERT until that template is approved.
PLATFORM_LEAD_TEMPLATE_NAME=platform_lead_intro
PLATFORM_LEAD_TEMPLATE_LANG=en

# --- Grounding gate (refuse ungrounded product/price replies) --------------
# off | shadow (log would-block; default) | enforce (swap in fallback)
GROUNDING_GATE_MODE=shadow
# GROUNDING_GATE_FALLBACK=Let me double-check that with the team and get right back to you 🙏

# --- Bot eval (WS3) --------------------------------------------------------
# Optional: git SHA stamped onto persisted eval runs (`eval:gate -- --persist`)
# so the /hq/eval dashboard shows which build a run covered. In CI
# GITHUB_SHA is used automatically; set EVAL_GIT_SHA to override locally.
# EVAL_GIT_SHA=

# --- Web (Next.js, prefixed with NEXT_PUBLIC for browser) ---------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Sales Scan ("Teach the bot with your own data") ---
# The WhatsApp capture service (platform-wa-ingest). Leave UNSET until it is deployed.
#
# Setting these says you INTEND to capture; it does NOT make the QR flow appear. A tenant
# is offered a QR only when the capture service is also ALIVE, proven by a heartbeat it
# emits every 60s while WA_CAPTURE_ENABLED=true on the ingest host. Until then
# /sales-scan/status reports ingestAvailable:false and /connect returns 503, so an
# activated tenant sees "scanning goes live soon" instead of a QR that can never appear.
# (Before 2026-08-05 these vars alone flipped the UI, which is how prod spent six days
# promising QR codes to tenants while the capture service had capture switched off.)
WA_INGEST_URL=
WA_INGEST_SECRET=

# "Sync contacts with phone" — the WhatsApp option. A SEPARATE secret from the two
# above, on purpose: isScanStartable() keys off WA_INGEST_URL/SECRET, so reusing them
# here would also arm Sales Scan capture, which 16 open blockers exist to prevent.
# Only a secret is needed, no URL — the ingest service pulls work from the platform and pushes
# results back, so the platform never dials out to it. Unset = the WhatsApp card is not offered
# and tenants see the Android + iPhone flows only.
# Must match WA_CONTACTS_SECRET on the wa-ingest host.
WA_CONTACTS_SECRET=

# the platform mobile app push notifications (FCM). The full Firebase service-account
# JSON as ONE line. Unset = push disabled (no-op) — the platform never depends
# on push to function.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Meta Embedded Signup / Coexistence -------------------------------------
# App "the platform Ai" (Tech Provider verified). All optional: unset => the
# /whatsapp/embedded-signup/exchange route 503s and nothing else changes.
# NOTE the five META_WA_* vars above are DEAD single-tenant leftovers; these are
# the live ones. Do not merge the two sets.
META_ES_APP_ID=
META_ES_APP_SECRET=
# Facebook Login for Business config id. NOT a secret — it ships in browser JS.
META_ES_CONFIG_ID=
META_GRAPH_VERSION=v25.0
