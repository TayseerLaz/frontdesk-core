// AI tier per tenant. Routes chat completions to a provider stack:
//   basic  — Groq Llama 3.3 70B primary + OpenAI gpt-4o-mini fallback (cheap)
//   middle — OpenAI gpt-4o (full model, premium quality)
//   max    — Anthropic Claude Opus 4.x (top-tier reasoning, highest cost)
// Editable from /hq. Default is `basic` so brand-new tenants
// don't accidentally land on a $$$ plan.
enum AiPlan {
  basic
  middle
  max
  // Flagship "Ultra" tier — hybrid orchestration: Claude Haiku 4.5 for the
  // cheap auxiliary passes (intent classification + per-contact persona
  // summarization) and Claude Sonnet 4.6 for the final grounded reply.
  // Pairs the grounding pipeline + post-LLM hallucination scanner with
  // per-user memory for the best speed/reasoning/faithfulness combo.
  ultra
}

