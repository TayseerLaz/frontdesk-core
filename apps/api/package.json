{
  "name": "@platform/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "echo 'api: no build step — running via tsx at runtime'",
    "clean": "rm -rf dist .turbo",
    "dev": "tsx watch --conditions=source --env-file=../../.env --clear-screen=false src/server.ts",
    "start": "tsx --conditions=source src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pure": "vitest run -c vitest.pure.config.ts",
    "test:syntax": "node scripts/check-test-syntax.mjs",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "eval": "tsx --conditions=source eval/runner.ts",
    "eval:gate": "tsx --conditions=source eval/runner.ts --all --retrieval-only",
    "eval:cart": "tsx --conditions=source eval/cart-sim.ts",
    "eval:replay": "tsx --conditions=source eval/gate-replay.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@call-e/calle": "0.7.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/under-pressure": "^9.0.3",
    "@platform/db": "workspace:*",
    "@platform/shared": "workspace:*",
    "@sentry/node": "^8.50.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.0",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.0.2",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.9.16",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "stripe": "^22.1.0",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
