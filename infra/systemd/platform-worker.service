# Canonical unit for the the platform background worker. See platform-api.service for
# why ExecStart uses `pnpm start` (--conditions=source → import from source).
[Unit]
Description=the platform Worker (BullMQ, tsx)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/platform/app/apps/worker
EnvironmentFile=/opt/platform/app/.env.production
ExecStart=/usr/bin/env pnpm start
Restart=always
RestartSec=3
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
